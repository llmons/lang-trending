---
interface Props {
  href?: string
}

const { href = import.meta.env.BASE_URL } = Astro.props
---

<a
  href={href}
  class="group inline-flex items-center gap-2.5"
  aria-label="lang.trending — home"
>
  <svg
    viewBox="0 0 128 128"
    class="size-5 transition-transform group-hover:scale-110"
    aria-hidden="true"
  >
    <!-- the lang.trending mark — canonical artwork in public/logo.svg (accent blue #2a78d6) -->
    <use href={`${import.meta.env.BASE_URL}logo.svg#mark`} />
  </svg>
  <span class="font-heading text-sm font-bold tracking-[0.25em] uppercase">
    lang<span class="text-viz-accent">·</span>trending
  </span>
</a>
