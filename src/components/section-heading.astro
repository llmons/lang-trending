---
interface Props {
  /** Editorial index, e.g. "01". */
  index: string
  title: string
  description?: string
  /** Right-aligned micro note, hidden on small screens. */
  aside?: string
}

const { index, title, description, aside } = Astro.props
---

<div class="mb-10 md:mb-14">
  <div class="flex items-baseline gap-4 border-b border-border pb-4">
    <span class="font-heading text-sm font-bold text-viz-accent tabular-nums">
      {index}
    </span>
    <h2 class="font-heading text-2xl font-semibold tracking-widest uppercase md:text-3xl">
      {title}
    </h2>
    {aside && (
      <span class="ml-auto hidden text-[0.625rem] font-semibold tracking-widest uppercase text-muted-foreground lg:block">
        {aside}
      </span>
    )}
  </div>
  {description && (
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground md:text-base">
      {description}
    </p>
  )}
</div>
