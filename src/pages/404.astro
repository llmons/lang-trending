---
import { buttonVariants } from "@/components/ui/button"
import Layout from "@/layouts/main.astro"
---

<Layout title="404 — lang.trending" description="This page does not exist.">
  <section class="mx-auto flex w-full max-w-3xl flex-col items-start px-6 py-24 md:py-32">
    <p
      class="font-serif text-[clamp(6rem,20vw,14rem)] leading-none font-bold text-transparent select-none [-webkit-text-stroke:1px_var(--viz-accent)]"
      aria-hidden="true"
    >
      404
    </p>
    <h1 class="mt-8 font-heading text-xl font-semibold tracking-widest uppercase md:text-2xl">
      This page does not exist
    </h1>
    <p class="mt-3 leading-relaxed text-muted-foreground">
      Unlike the languages in the ranking, this page has zero repositories. The
      index itself is still counting.
    </p>
    <a
      href="/"
      class:list={[buttonVariants({ variant: "default", size: "lg" }), "mt-8"]}
    >
      Back to the ranking
    </a>
  </section>
</Layout>
