---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { Octokit } from "octokit";
import { languages } from "../base/consts";
import { sleep, getPassYear } from "../base/utils";
import Icon from "../components/Icon.astro";

const octokit = new Octokit({
	throttle: {
		enabled: import.meta.env.PROD,
	},
});
const passYear = getPassYear();
for (const [i, lang] of languages.entries()) {
	const queryString = `language:${lang} created:>=${passYear} stars:>=100`;

	const resp = await octokit.request("GET /search/repositories", {
		headers: {
			"X-GitHub-Api-Version": "2026-03-10",
		},
		q: queryString,
	});

	if (import.meta.env.PROD) {
		await sleep(6000); // github api allows 10 requests per minute
	}

	languages[i].count = resp.data.total_count;
}

languages.sort((a, b) => b.count - a.count);
---

<Layout>
	<header class="flex items-center p-2">
		<span class="mr-auto text-3xl">Lang Trends</span>
		<a href="https://github.com/llmons/lang-trends">
			<Icon name="github" className="size-8"/>
		</a>
	</header>
	<main>
		<div class="p-2">
			<span
				>Languages ranked by new repositories with >100 stars on GitHub
				in the past year</span
			>
		</div>
		<div class="grid gap-2">
			{
				languages.map((lang, i) => (
					<div class="flex gap-2 items-center border p-2">
						<span class="mr-auto">{i + 1}</span>
						<Icon name={lang.name} className="size-8" />
						<span>{lang.count}</span>
					</div>
				))
			}
		</div>
	</main>
	<footer class="flex justify-center items-center">
		<span class="text-gray-500">Data from GitHub Search API</span>
	</footer>
</Layout>
